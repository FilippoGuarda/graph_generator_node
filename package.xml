<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>graph_generator_node</name>
  <version>0.1.0</version>
  <description>
    Skeleton-based topological graph generation from shared costmaps.
    Implements GRID-FAST gap analysis, skeleton extraction, and multi-source BFS
    graph construction for multi-robot path planning and task allocation.
  </description>
  <maintainer email="filippo.guarda2@unibo.it">Filippo Guarda</maintainer>
  <license>Apache-2.0</license>

  <author email="filippo.guarda2@unibo.it">Filippo Guarda</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>nav_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>opencv</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
